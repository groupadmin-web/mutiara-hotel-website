---
// src/components/rooms.astro
import roomsData from "../content/rooms.json";
---

<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>

<section
  id="rooms"
  class="scroll-mt-24 bg-slate-50 py-20 px-6 border-y border-slate-100">
  <div class="max-w-7xl mx-auto">
    {/* Section Header */}
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span
        class="text-amber-600 font-bold text-xs uppercase tracking-widest bg-amber-50 px-3 py-1 rounded-full"
        >Accommodations</span
      >
      <h2
        class="text-3xl md:text-4xl font-serif font-bold text-slate-900 mt-3 mb-4">
        Our Luxurious Rooms & Suites
      </h2>
      <div class="h-0.5 w-16 bg-amber-500 mx-auto mb-4"></div>
      <p class="text-slate-600 text-sm md:text-base">
        Discover modern comfort fused with historic boutique charm. Our wide
        array of accommodations provides the perfect sanctuary in the heart of
        Bandung.
      </p>
    </div>

    {/* Dynamic Grid from rooms.json */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        roomsData.map((room) => {
          const {
            title,
            description,
            image,
            capacity,
            bed_type,
            view,
            features,
            booking_url,
            room_gallery1,
            room_gallery2,
            room_gallery3,
          } = room;

          const gallery = [
            image,
            room_gallery1,
            room_gallery2,
            room_gallery3,
          ].filter(Boolean);

          const bookingLink =
            booking_url || "https://booking.mutiarahotel.com/";

          return (
            <div class="group bg-white rounded-2xl shadow-sm hover:shadow-xl border border-slate-100 overflow-hidden flex flex-col justify-between transition-all duration-300 transform hover:-translate-y-1">
              <div>
                {/* ROOM IMAGE PREVIEW */}
                <div class="relative overflow-hidden aspect-[4/3] bg-slate-200">
                  {image ? (
                    <img
                      src={image}
                      alt={title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                  ) : (
                    <div class="w-full h-full flex flex-col items-center justify-center bg-slate-900 text-slate-400 p-6 text-center">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="w-8 h-8 text-amber-500 mb-2">
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"
                        />
                      </svg>
                      <span
                        class="text-xs font-serif tracking-wider text-slate-300"
                        translate="no">
                        {title} Preview
                      </span>
                    </div>
                  )}

                  {view && (
                    <span class="absolute top-3 right-3 bg-slate-900/80 backdrop-blur-md text-white text-[10px] font-bold px-2.5 py-1 rounded-md uppercase tracking-wider">
                      {view}
                    </span>
                  )}
                </div>

                {/* Metadata Row */}
                <div class="flex items-center justify-between border-b border-slate-50 bg-slate-50/50 px-6 py-3 text-xs text-slate-500 font-medium uppercase tracking-wider">
                  {bed_type && (
                    <span class="flex items-center gap-1.5">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="2"
                        stroke="currentColor"
                        class="w-4 h-4 text-slate-400">
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"
                        />
                      </svg>
                      {bed_type}
                    </span>
                  )}
                  {capacity && (
                    <span class="flex items-center gap-1.5 text-right">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="2"
                        stroke="currentColor"
                        class="w-4 h-4 text-slate-400">
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"
                        />
                      </svg>
                      {capacity}
                    </span>
                  )}
                </div>

                {/* Content */}
                <div class="p-6">
                  <h3
                    class="font-serif font-bold text-xl text-slate-900 mb-3 uppercase tracking-wide"
                    translate="no">
                    {title}
                  </h3>
                  <p class="text-slate-600 text-xs md:text-sm leading-relaxed mb-6">
                    {description}
                  </p>

                  {/* Feature Tags */}
                  {features && (
                    <div class="flex flex-wrap gap-2">
                      {features.map((feature: string) => (
                        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-600 bg-slate-100 border border-slate-200/60 px-2.5 py-1 rounded-md">
                          {feature}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              </div>

              {/* VIEW GALLERY BUTTON */}
              <div class="p-6 pt-0 mt-auto">
                <button
                  type="button"
                  class="room-gallery-btn w-full bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs tracking-widest uppercase py-3.5 rounded-xl transition-all duration-300 flex items-center justify-center gap-2 shadow-sm hover:shadow-md"
                  data-room={JSON.stringify({
                    title,
                    description,
                    gallery,
                    features,
                    booking_url: bookingLink,
                  })}>
                  VIEW GALLERY
                </button>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>

  {/* GALLERY MODAL WINDOW WITH BOOK NOW BUTTON */}
  <div
    id="room-gallery-modal"
    class="fixed inset-0 z-50 hidden bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 md:p-8">
    <div
      class="bg-white rounded-2xl overflow-hidden max-w-4xl w-full max-h-[90vh] flex flex-col md:flex-row shadow-2xl relative">
      {/* Close Modal Button */}
      <button
        id="close-modal-btn"
        type="button"
        class="absolute top-4 right-4 z-20 bg-slate-100 hover:bg-slate-200 text-slate-700 p-2 rounded-full transition-colors">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      {/* Gallery Section */}
      <div
        class="w-full md:w-3/5 bg-slate-900 p-4 flex flex-col justify-between">
        <div class="relative aspect-[4/3] rounded-xl overflow-hidden bg-black">
          <img
            id="modal-main-image"
            src=""
            alt="Room Gallery"
            class="w-full h-full object-cover transition-all duration-300"
          />
        </div>
        <div id="modal-thumbnails" class="grid grid-cols-4 gap-2 mt-4">
          {/* Gallery Thumbnails injected dynamically */}
        </div>
      </div>

      {/* Info & Book Now Section */}
      <div
        class="w-full md:w-2/5 p-6 md:p-8 flex flex-col justify-between overflow-y-auto bg-white">
        <div>
          <h3
            id="modal-title"
            class="text-2xl font-serif font-bold text-slate-900 uppercase tracking-wide">
          </h3>
          <p
            id="modal-description"
            class="mt-4 text-xs md:text-sm text-slate-600 leading-relaxed">
          </p>

          <div id="modal-features" class="mt-6 flex flex-wrap gap-2">
            {/* Dynamic Feature Tags */}
          </div>
        </div>

        {/* DYNAMIC BOOK NOW BUTTON IN MODAL */}
        <div class="mt-8 pt-4 border-t border-slate-100">
          <a
            id="modal-booking-btn"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs tracking-widest uppercase py-3.5 px-6 rounded-xl transition-colors shadow-md flex items-center justify-center gap-2 text-center">
            <span>BOOK NOW</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke="currentColor"
              class="w-4 h-4">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const modal = document.getElementById("room-gallery-modal");
    const closeModalBtn = document.getElementById("close-modal-btn");
    const mainImg = document.getElementById("modal-main-image");
    const thumbnailsContainer = document.getElementById("modal-thumbnails");
    const modalTitle = document.getElementById("modal-title");
    const modalDesc = document.getElementById("modal-description");
    const modalFeatures = document.getElementById("modal-features");
    const modalBookingBtn = document.getElementById("modal-booking-btn");

    document.querySelectorAll(".room-gallery-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const data = JSON.parse(btn.getAttribute("data-room"));

        modalTitle.textContent = data.title;
        modalDesc.textContent = data.description;
        modalBookingBtn.href =
          data.booking_url || "https://booking.mutiarahotel.com/";

        // Render Thumbnails
        if (data.gallery && data.gallery.length > 0) {
          mainImg.src = data.gallery[0];
          thumbnailsContainer.innerHTML = "";

          data.gallery.forEach((imgUrl, index) => {
            const thumb = document.createElement("img");
            thumb.src = imgUrl;
            thumb.className = `w-full aspect-video object-cover rounded-lg cursor-pointer border-2 transition-all ${index === 0 ? "border-amber-500" : "border-transparent opacity-70 hover:opacity-100"}`;
            thumb.addEventListener("click", () => {
              mainImg.src = imgUrl;
              Array.from(thumbnailsContainer.children).forEach((c) =>
                c.classList.replace("border-amber-500", "border-transparent"),
              );
              thumb.classList.replace("border-transparent", "border-amber-500");
            });
            thumbnailsContainer.appendChild(thumb);
          });
        }

        // Render Features
        modalFeatures.innerHTML = "";
        if (data.features) {
          data.features.forEach((feat) => {
            const tag = document.createElement("span");
            tag.className =
              "text-[10px] font-bold uppercase tracking-wider text-slate-700 bg-slate-100 px-2 py-1 rounded-md";
            tag.textContent = feat;
            modalFeatures.appendChild(tag);
          });
        }

        modal.classList.remove("hidden");
      });
    });

    closeModalBtn?.addEventListener("click", () =>
      modal.classList.add("hidden"),
    );
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) modal.classList.add("hidden");
    });
  });
</script>

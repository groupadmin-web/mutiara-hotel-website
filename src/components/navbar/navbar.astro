---
// src/components/navbar/navbar.astro
import Container from "@/components/container.astro";
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import homepageData from "@/content/homepage.json";

const requestUrlPath = new URL(Astro.request.url).pathname;
const currentPath = requestUrlPath.toLowerCase().replace(/\/$/, "") || "/";

const menuitems = [
  { title: "HOME", path: "/" },
  { title: "ROOMS", path: "/rooms" },
  { title: "CULINARY", path: "/food" },
  { title: "TOURIST ATTRACTIONS", path: "/attractions" },
  { title: "GALLERY", path: "/gallery" },
  { title: "MEETINGS & EVENTS", path: "/meetings-events" },
  { title: "Q&A", path: "/qna" },
  { title: "CONTACT", path: "/#footer" },
];
---

<!-- ALARIC CALENDAR STYLESHEET -->
<link
  rel="stylesheet"
  href="https://static.alaric.id/css/daterangepicker.css"
/>

<style is:global>
  /* Calendar price tag styling */
  .daterangepicker td .rate-tag {
    display: block;
    font-size: 9px;
    font-weight: 700;
    color: #d97706;
    line-height: 1;
    margin-top: 1px;
  }
  .daterangepicker td.active .rate-tag,
  .daterangepicker td.in-range .rate-tag {
    color: #ffffff !important;
  }
</style>

<header
  class="sticky top-0 z-40 w-full bg-white shadow-sm transition-all border-b border-gray-100">
  <Container>
    <div
      class="flex flex-col lg:flex-row justify-between items-center py-3 w-full min-h-[72px] lg:min-h-0 gap-3">
      <Astronav>
        <div
          class="flex w-full lg:w-auto items-center justify-between relative">
          <a href="/" class="flex items-center tracking-wider font-serif group">
            {
              homepageData.logo_image ? (
                <img
                  src={homepageData.logo_image}
                  alt="Mutiara Hotel & Convention Bandung Logo"
                  class="h-12 md:h-14 w-auto object-contain max-w-[160px] md:max-w-[180px] transition-transform duration-300 group-hover:scale-105"
                />
              ) : (
                <span class="font-bold text-xl text-slate-900 uppercase">
                  {homepageData.logo_text || "MUTIARA"}
                </span>
              )
            }
          </a>

          <div
            class="block lg:hidden absolute top-[12px] right-1 z-50 text-slate-950 hover:text-amber-600 transition-colors cursor-pointer p-1">
            <MenuIcon class="w-6 h-6" />
          </div>
        </div>

        <MenuItems
          class="hidden w-full lg:w-auto mt-4 pt-14 lg:pt-0 lg:flex lg:mt-0 relative z-50">
          <ul
            class="flex flex-col lg:flex-row items-start lg:items-center gap-1 lg:gap-2 w-full">
            {
              menuitems.map((item, index) => {
                const itemNormalizedPath =
                  item.path.toLowerCase().replace(/\/$/, "") || "/";
                const isActive =
                  itemNormalizedPath === "/"
                    ? currentPath === "/"
                    : currentPath.startsWith(itemNormalizedPath);
                return (
                  <>
                    {item.children && (
                      <Dropdown
                        title={item.title}
                        children={item.children}
                        lastItem={index === menuitems.length - 1}
                      />
                    )}
                    {!item.children && (
                      <li class="w-full lg:w-auto">
                        <a
                          href={item.path}
                          class={`nav-item flex lg:px-2.5 py-2 items-center text-xs font-bold tracking-wide transition-all uppercase relative after:absolute after:bottom-0 after:left-2.5 after:right-2.5 after:h-0.5 after:bg-amber-600 after:transition-transform after:duration-300 ${
                            isActive
                              ? "text-amber-600 after:scale-x-100"
                              : "text-slate-700 hover:text-amber-600 after:scale-x-0 hover:after:scale-x-100"
                          }`}>
                          <span>{item.title}</span>
                        </a>
                      </li>
                    )}
                  </>
                );
              })
            }
          </ul>
        </MenuItems>
      </Astronav>

      <!-- INTERACTIVE BOOKING WIDGET BAR -->
      <form
        id="mutiara-booking-widget"
        action="https://booking.mutiarahotel.com/rates/index"
        method="GET"
        target="_blank"
        class="flex items-center gap-2 bg-slate-50 p-1.5 rounded-xl border border-slate-200/80 shadow-inner notranslate w-full lg:w-auto justify-between lg:justify-start">
        <input type="hidden" name="hotel_key" value="MHBH" />

        <!-- Checkin / Checkout Input -->
        <div
          class="flex items-center gap-1.5 px-2 py-1 bg-white rounded-lg border border-slate-200 cursor-pointer shadow-xs">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4 text-amber-600 shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
            ></path>
          </svg>
          <div class="flex flex-col text-left">
            <span
              class="text-[8px] font-bold text-slate-400 uppercase tracking-wider"
              >DATES</span
            >
            <input
              type="text"
              id="mutiara-date-range"
              class="text-xs font-bold text-slate-800 bg-transparent outline-none cursor-pointer w-36"
              readonly
            />
          </div>
          <input type="hidden" id="widget-checkin" name="checkin" />
          <input type="hidden" id="widget-checkout" name="checkout" />
        </div>

        <!-- Guests Selector -->
        <div
          class="flex items-center gap-1.5 px-2 py-1 bg-white rounded-lg border border-slate-200 shadow-xs">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4 text-amber-600 shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
            ></path>
          </svg>
          <div class="flex flex-col text-left">
            <span
              class="text-[8px] font-bold text-slate-400 uppercase tracking-wider"
              >GUESTS</span
            >
            <select
              name="adults"
              id="widget-adults"
              class="text-xs font-bold text-slate-800 bg-transparent outline-none cursor-pointer pr-1">
              <option value="1">1 Adult</option>
              <option value="2" selected>2 Adults</option>
              <option value="3">3 Adults</option>
              <option value="4">4 Adults</option>
            </select>
          </div>
        </div>

        <!-- Submit Button -->
        <button
          type="submit"
          class="bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs px-4 py-2.5 rounded-lg shadow-md transition-all uppercase tracking-wider cursor-pointer whitespace-nowrap shrink-0">
          Book
        </button>
      </form>
    </div>
  </Container>
</header>

<!-- JQUERY, MOMENT & DATERANGEPICKER SCRIPTS -->
<script
  is:inline
  src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"
></script>
<script
  is:inline
  src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"
></script>
<script is:inline src="https://static.alaric.id/js/daterangepicker.min.js"
></script>

<script is:inline>
  function initMutiaraBookingWidget() {
    const $dateInput = $("#mutiara-date-range");
    if (!$dateInput.length) return;

    const startDate = moment().add(1, "days");
    const endDate = moment().add(2, "days");

    $("#widget-checkin").val(startDate.format("YYYY-MM-DD"));
    $("#widget-checkout").val(endDate.format("YYYY-MM-DD"));

    $dateInput.daterangepicker(
      {
        startDate: startDate,
        endDate: endDate,
        minDate: moment(),
        autoApply: true,
        locale: {
          format: "DD MMM YYYY",
        },
      },
      function (start, end) {
        $("#widget-checkin").val(start.format("YYYY-MM-DD"));
        $("#widget-checkout").val(end.format("YYYY-MM-DD"));
      },
    );

    // FETCH ALARIC DAILY CALENDAR RATES FOR MHBH PROPERTY KEY
    $.ajax({
      url: "https://webapi-sg.alaric.id/mhb/x/calendar/MHBH",
      method: "GET",
      dataType: "json",
      success: function (response) {
        if (!response || !response.data) return;
        const ratesMap = response.data;

        $dateInput.on("show.daterangepicker", function (ev, picker) {
          setTimeout(() => injectRatesIntoPicker(picker, ratesMap), 50);
        });

        $dateInput.on(
          "next.daterangepicker prev.daterangepicker",
          function (ev, picker) {
            setTimeout(() => injectRatesIntoPicker(picker, ratesMap), 50);
          },
        );
      },
    });
  }

  function injectRatesIntoPicker(picker, ratesMap) {
    picker.container.find(".calendar-table td.available").each(function () {
      const $td = $(this);
      const titleAttr = $td.attr("data-title");
      if (!titleAttr) return;

      const dayText = $td.text().trim().split("\n")[0];
      if (!dayText || isNaN(dayText)) return;

      const dateKey =
        picker.startDate.format("YYYY-MM-") + dayText.padStart(2, "0");
      if (ratesMap[dateKey]) {
        $td.find(".rate-tag").remove();
        $td.append(`<span class="rate-tag">${ratesMap[dateKey]}</span>`);
      }
    });
  }

  $(document).ready(initMutiaraBookingWidget);
  document.addEventListener("astro:after-swap", initMutiaraBookingWidget);
</script>
